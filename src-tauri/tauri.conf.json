{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "光阶Todo",
  "version": "0.1.0",
  "identifier": "com.guangjie.todo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "node src-tauri/scripts/copy-resources.cjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ascend Todo — Master your time, elevate your life.",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "resources": {
      "resources/WebView2Loader.dll": "WebView2Loader.dll"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "光阶Todo - 拾光而上，有序人生",
    "longDescription": "A cross-platform Todo app with boards, goals, calendar, and pomodoro.",
    "publisher": "Mark",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "languages": ["SimpChinese", "TradChinese", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine"
      },
      "wix": {
        "language": {
          "zh-CN": {
            "localePath": "wix-locale.wxl"
          }
        }
      }
    }
  },
  "plugins": {}
}

